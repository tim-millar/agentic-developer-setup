#!/bin/sh
unset BASH_ENV ENV CDPATH
if [ ! -x /bin/bash ]; then
  echo "claude-explore: required executable is unavailable: /bin/bash" >&2
  exit 1
fi
if ! /usr/bin/env -u BASH_ENV -u ENV -u SHELLOPTS -u BASHOPTS -u CDPATH /bin/bash --noprofile --norc -c '[ "$BASH_VERSINFO" -gt 3 ] || { [ "$BASH_VERSINFO" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -ge 2 ]; }' 2>/dev/null; then
  echo "claude-explore: /bin/bash >= 3.2 is required" >&2
  exit 1
fi
if [ -x /usr/bin/realpath ]; then REALPATH_BIN=/usr/bin/realpath
elif [ -x /bin/realpath ]; then REALPATH_BIN=/bin/realpath
else
  echo "claude-explore: required executable is unavailable: realpath" >&2
  exit 1
fi
SELF_REAL=$($REALPATH_BIN "$0" 2>/dev/null) || exit 1
SCRIPT_DIR=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$SELF_REAL")" 2>/dev/null && pwd -P) || exit 1
exec /usr/bin/env -u BASH_ENV -u ENV -u SHELLOPTS -u BASHOPTS -u CDPATH /bin/bash --noprofile --norc "$SCRIPT_DIR/../lib/claude_explore_runtime.sh" "$@"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-millar/agentic-developer-setup/schemas/agent-run-telemetry-v1.schema.json",
  "title": "Agent Development Framework execution run telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "state", "runtime", "configuration", "repository", "task", "timing", "termination", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"},
    "state": {"enum": ["started", "completed", "preflight_failed", "launch_failed", "runtime_failed", "launcher_failed", "interrupted"]},
    "runtime": {"$ref": "#/$defs/runtime"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "repository": {"$ref": "#/$defs/repository"},
    "task": {"$ref": "#/$defs/task"},
    "timing": {"$ref": "#/$defs/timing"},
    "termination": {"$ref": "#/$defs/termination"},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "started"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timing": {
            "properties": {
              "run_finished_at": {"type": "null"},
              "calendar_elapsed_ms": {"type": "null"}
            }
          },
          "termination": {
            "properties": {
              "child_exit_code": {"type": "null"},
              "signal": {"type": "null"},
              "reason": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"enum": ["completed", "preflight_failed", "launch_failed", "runtime_failed", "launcher_failed", "interrupted"]}
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "timing": {
            "properties": {
              "run_finished_at": {"$ref": "#/$defs/timestamp"},
              "calendar_elapsed_ms": {"type": "integer", "minimum": 0}
            }
          },
          "termination": {"properties": {"reason": {"type": "string"}}}
        }
      }
    }
  ],
  "$defs": {
    "runtime_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "value"],
      "properties": {
        "evidence_kind": {"enum": ["launcher_requested", "runtime_observed", "launcher_guaranteed", "unavailable", "not_applicable"]},
        "value": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"evidence_kind": {"enum": ["unavailable", "not_applicable"]}}}, "then": {"properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"evidence_kind": {"enum": ["launcher_requested", "runtime_observed", "launcher_guaranteed"]}}}, "then": {"properties": {"value": {"type": "string"}}}}
      ]
    },
    "configuration_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "value", "source"],
      "properties": {
        "evidence_kind": {"enum": ["launcher_requested", "runtime_observed", "launcher_guaranteed", "unavailable", "not_applicable"]},
        "value": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"evidence_kind": {"enum": ["unavailable", "not_applicable"]}}}, "then": {"properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"evidence_kind": {"enum": ["launcher_requested", "runtime_observed", "launcher_guaranteed"]}}}, "then": {"properties": {"value": {"type": "string"}}}}
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "harness", "session"],
      "properties": {
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {"enum": ["codex-cli", "claude-code"]},
            "version": {"$ref": "#/$defs/runtime_observation"}
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "revision"],
          "properties": {
            "id": {"enum": ["agent-development-framework/codex", "agent-development-framework/claude-explore"]},
            "version": {"type": "integer", "minimum": 1},
            "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "session": {"$ref": "#/$defs/runtime_observation"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "configuration_stability"],
      "properties": {
        "model": {"$ref": "#/$defs/configuration_pair"},
        "reasoning_effort": {"$ref": "#/$defs/configuration_pair"},
        "configuration_stability": {"enum": ["unchanged", "changed", "unknown"]}
      }
    },
    "configuration_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "initial_effective"],
      "properties": {
        "requested": {"$ref": "#/$defs/configuration_observation"},
        "initial_effective": {"$ref": "#/$defs/configuration_observation"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "start", "finish"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["github", "path_digest"]},
            "value": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "github"}}, "required": ["kind"]},
              "then": {"properties": {"value": {"pattern": "^[A-Za-z0-9_.-]{1,100}/(?![A-Za-z0-9_.-]*[.]git(?![\\s\\S]))[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"}}}
            },
            {
              "if": {"properties": {"kind": {"const": "path_digest"}}, "required": ["kind"]},
              "then": {"properties": {"value": {"pattern": "^sha256:[0-9a-f]{64}$"}}}
            }
          ]
        },
        "start": {"oneOf": [{"$ref": "#/$defs/git_state"}, {"type": "null"}]},
        "finish": {"oneOf": [{"$ref": "#/$defs/git_state"}, {"type": "null"}]}
      }
    },
    "git_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "detached", "head_sha", "dirty", "staged_count", "unstaged_count", "untracked_count"],
      "properties": {
        "branch": {"type": ["string", "null"]},
        "detached": {"type": "boolean"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "dirty": {"type": "boolean"},
        "staged_count": {"type": "integer", "minimum": 0},
        "unstaged_count": {"type": "integer", "minimum": 0},
        "untracked_count": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"detached": {"const": true}}, "required": ["detached"]},
          "then": {"properties": {"branch": {"type": "null"}}},
          "else": {"properties": {"branch": {"type": "string"}}}
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "identifier", "content_sha256", "snapshot"],
      "properties": {
        "source": {"enum": ["github_issue", "local_prompt", "composite", "unavailable"]},
        "identifier": {"type": ["string", "null"]},
        "content_sha256": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
        "snapshot": {"enum": ["task.txt", null]}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "unavailable"}}, "required": ["source"]},
          "then": {
            "properties": {
              "identifier": {"type": "null"},
              "content_sha256": {"type": "null"},
              "snapshot": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"snapshot": {"const": "task.txt"}}, "required": ["snapshot"]},
          "then": {"properties": {"content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
        },
        {
          "if": {"properties": {"content_sha256": {"type": "string"}}, "required": ["content_sha256"]},
          "then": {"properties": {"snapshot": {"const": "task.txt"}}}
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_started_at", "child_started_at", "child_finished_at", "run_finished_at", "calendar_elapsed_ms"],
      "properties": {
        "run_started_at": {"$ref": "#/$defs/timestamp"},
        "child_started_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "child_finished_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "run_finished_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "calendar_elapsed_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_exit_code", "signal", "reason"],
      "properties": {
        "child_exit_code": {"type": ["integer", "null"], "minimum": 0},
        "signal": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}

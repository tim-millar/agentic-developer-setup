{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-manifest-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
    },
    "category": {
      "type": "string",
      "enum": [
        "ecosystem",
        "framework",
        "runtime",
        "app-shape"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "detection_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "contribution_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "findings",
          "commands",
          "command_wrappers",
          "validation_profiles",
          "paths",
          "services",
          "requirements",
          "inputs",
          "component_recommendations",
          "documentation_requirements"
        ]
      },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "ecosystem",
                  "framework",
                  "runtime",
                  "app-shape"
                ]
              },
              "one_of": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "category",
              "one_of"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "incompatible": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "ecosystem",
                  "framework",
                  "runtime",
                  "app-shape"
                ]
              },
              "one_of": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "category",
              "one_of"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "requires",
        "incompatible"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(ecosystem|framework|runtime|app-shape)/[a-z][a-z0-9-]*\\.[a-z][a-z0-9_.-]*$(?![\\s\\S])"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "boolean",
              "integer",
              "relative_path"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "allowed_values": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "boolean",
                "integer"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "default": {
            "type": [
              "string",
              "boolean",
              "integer"
            ]
          }
        },
        "required": [
          "key",
          "type",
          "required",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "provider": {
      "type": "object",
      "properties": {
        "file": {
          "const": "adapter.rb",
          "type": "string"
        },
        "constant": {
          "type": "string",
          "minLength": 1,
          "pattern": "^AgenticDeveloperSetup::Adapters::Providers::[A-Z][A-Za-z0-9_]*(::[A-Z][A-Za-z0-9_]*)*$(?![\\s\\S])"
        }
      },
      "required": [
        "file",
        "constant"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "category",
    "version",
    "description",
    "capabilities",
    "detection_signals",
    "contribution_domains",
    "compatibility",
    "inputs",
    "provider"
  ],
  "additionalProperties": false
}

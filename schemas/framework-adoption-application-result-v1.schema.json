{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-millar/agentic-developer-setup/schemas/framework-adoption-application-result-v1.schema.json",
  "title": "Framework adoption application journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "operation",
    "target",
    "source",
    "started_at",
    "finished_at",
    "status",
    "actions",
    "metadata",
    "diagnostics",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "in_progress",
        "applied_unvalidated",
        "no_changes",
        "refused",
        "partially_applied"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "action",
          "target_path",
          "previous",
          "intended",
          "observed",
          "reviewed_content",
          "state",
          "diagnostics"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "action": {
            "$ref": "#/$defs/action_name"
          },
          "target_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "previous": {
            "$ref": "#/$defs/identity"
          },
          "intended": {
            "$ref": "#/$defs/identity"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/identity"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewed_content": {
            "anyOf": [
              {
                "$ref": "#/$defs/file"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "pending",
              "started",
              "completed",
              "failed"
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/diagnostic"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "written",
        "verified",
        "expected_digest",
        "actual_digest"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "written": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "expected_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "minItems": 0
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_occurred",
        "inspect_paths",
        "metadata_written",
        "fresh_plan_required",
        "interruption_uncertainty"
      ],
      "properties": {
        "mutation_occurred": {
          "type": "boolean"
        },
        "inspect_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "metadata_written": {
          "type": "boolean"
        },
        "fresh_plan_required": {
          "type": "boolean"
        },
        "interruption_uncertainty": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.($|/))(?!.*(^|/)\\.\\.($|/)).+$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "repository"
            },
            "path": {
              "const": "."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "workspace"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "mode"
      ],
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-7]{4}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mode": {
          "enum": [
            "0644",
            "0755"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "head",
        "scope"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "$ref": "#/$defs/revision"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "revision",
        "version",
        "catalogue_digest"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "component_id",
        "path",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action_name": {
      "enum": [
        "create_inherited",
        "create_specialised",
        "record_repository_owned",
        "record_inactive",
        "update_inherited",
        "convert_to_specialised",
        "no_change"
      ]
    },
    "operation": {
      "enum": [
        "initial_adoption",
        "add_components",
        "update_inherited",
        "reconcile_inherited"
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

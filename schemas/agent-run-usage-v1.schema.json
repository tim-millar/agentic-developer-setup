{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-millar/agentic-developer-setup/schemas/agent-run-usage-v1.schema.json",
  "title": "Agent Development Framework run usage evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "collection", "provider_sessions", "measurements", "observed_totals", "cost_summary"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"},
    "collection": {"$ref": "#/$defs/collection"},
    "provider_sessions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "measurements": {
      "type": "array",
      "items": {"$ref": "#/$defs/measurement"}
    },
    "observed_totals": {"$ref": "#/$defs/observed_totals"},
    "cost_summary": {"$ref": "#/$defs/cost_summary"}
  },
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "nullable_nonnegative_integer": {"type": ["integer", "null"], "minimum": 0},
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source_interface", "client_version", "finalized_at", "reason", "warnings"],
      "properties": {
        "state": {"enum": ["complete", "partial", "unavailable", "disabled"]},
        "source_interface": {
          "type": ["string", "null"],
          "enum": ["claude_code_otel_api_request_v1", "codex_otel_response_completed_v1", null]
        },
        "client_version": {"$ref": "#/$defs/nullable_string"},
        "finalized_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
        "reason": {
          "type": ["string", "null"],
          "enum": [
            "collector_unavailable",
            "collector_setup_failed",
            "unsupported_provider_interface",
            "collector_parse_failed",
            "collector_shutdown_incomplete",
            "source_unavailable",
            "normalization_inconsistent",
            "usage_telemetry_disabled",
            null
          ]
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex_cached_input_exceeds_total",
              "relevant_event_malformed",
              "collector_parse_failed",
              "collector_shutdown_incomplete"
            ]
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_total", "input_uncached", "input_cache_read", "input_cache_write", "output_total", "output_reasoning"],
      "properties": {
        "input_total": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "input_uncached": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "input_cache_read": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "input_cache_write": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_total": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_reasoning": {"$ref": "#/$defs/nullable_nonnegative_integer"}
      }
    },
    "claude_native_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input_tokens", "output_tokens", "cache_read_tokens", "cache_creation_tokens"],
      "properties": {
        "kind": {"const": "claude_code_api_request"},
        "input_tokens": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_tokens": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "cache_read_tokens": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "cache_creation_tokens": {"$ref": "#/$defs/nullable_nonnegative_integer"}
      }
    },
    "codex_native_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input_token_count", "output_token_count", "cached_token_count", "cache_write_token_count", "reasoning_token_count"],
      "properties": {
        "kind": {"const": "codex_response_completed"},
        "input_token_count": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_token_count": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "cached_token_count": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "cache_write_token_count": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "reasoning_token_count": {"$ref": "#/$defs/nullable_nonnegative_integer"}
      }
    },
    "runtime_cost": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["semantics", "currency", "usd_micros"],
      "properties": {
        "semantics": {"const": "runtime_estimated"},
        "currency": {"const": "USD"},
        "usd_micros": {"type": "integer", "minimum": 0}
      }
    },
    "measurement": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": ["provider", "native_usage"],
          "properties": {
            "provider": {"const": "anthropic"},
            "native_usage": {"$ref": "#/$defs/claude_native_usage"}
          }
        },
        {
          "type": "object",
          "required": ["provider", "native_usage", "runtime_cost"],
          "properties": {
            "provider": {"const": "openai"},
            "native_usage": {"$ref": "#/$defs/codex_native_usage"},
            "runtime_cost": {"type": "null"}
          }
        }
      ],
      "additionalProperties": false,
      "required": ["sequence", "provider", "provider_session_id", "model", "request_source", "service_tier", "reasoning_effort", "duration_ms", "tokens", "native_usage", "runtime_cost"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "provider": {"enum": ["anthropic", "openai"]},
        "provider_session_id": {"$ref": "#/$defs/nullable_string"},
        "model": {"type": "string", "minLength": 1},
        "request_source": {"$ref": "#/$defs/nullable_string"},
        "service_tier": {"$ref": "#/$defs/nullable_string"},
        "reasoning_effort": {"$ref": "#/$defs/nullable_string"},
        "duration_ms": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "tokens": {"$ref": "#/$defs/tokens"},
        "native_usage": {
          "oneOf": [
            {"$ref": "#/$defs/claude_native_usage"},
            {"$ref": "#/$defs/codex_native_usage"}
          ]
        },
        "runtime_cost": {"$ref": "#/$defs/runtime_cost"}
      }
    },
    "observed_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_count", "input_total", "input_uncached", "input_cache_read", "input_cache_write", "output_total", "output_reasoning"],
      "properties": {
        "measurement_count": {"type": "integer", "minimum": 0},
        "input_total": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "input_uncached": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "input_cache_read": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "input_cache_write": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_total": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "output_reasoning": {"$ref": "#/$defs/nullable_nonnegative_integer"}
      }
    },
    "cost_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "semantics", "currency", "observed_usd_micros", "priced_measurement_count", "measurement_count", "reason"],
      "properties": {
        "state": {"enum": ["complete", "partial", "unavailable", "not_applicable"]},
        "semantics": {"type": ["string", "null"], "enum": ["runtime_estimated", null]},
        "currency": {"type": ["string", "null"], "enum": ["USD", null]},
        "observed_usd_micros": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "priced_measurement_count": {"type": "integer", "minimum": 0},
        "measurement_count": {"type": "integer", "minimum": 0},
        "reason": {"type": ["string", "null"], "enum": ["source_does_not_report_cost", "runtime_cost_missing", "collection_incomplete", null]}
      }
    }
  }
}
